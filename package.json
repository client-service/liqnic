{
  "name": "liqnic",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "APP_ENV=local pnpm --filter=backend dev",
    "dev:backend:dev": "APP_ENV=dev pnpm --filter=backend dev",
    "dev:dashboard": "pnpm --filter=@medusajs/dashboard dev",
    "dev:storefront": "pnpm --filter=medusa-next dev",
    "build:backend": "pnpm --filter=backend build",
    "build:dashboard": "pnpm --filter=@medusajs/dashboard build",
    "build:storefront": "pnpm --filter=medusa-next build",
    "build": "pnpm --filter=backend build && pnpm --filter=@medusajs/dashboard build && pnpm --filter=medusa-next build",
    "migrate:local": "APP_ENV=local pnpm --filter=backend exec npx medusa db:migrate",
    "migrate:dev": "APP_ENV=dev pnpm --filter=backend exec npx medusa db:migrate",
    "seed:local": "APP_ENV=local pnpm --filter=backend seed",
    "lint": "pnpm --recursive run lint"
  }
}
